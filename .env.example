# Copy to Vercel Project → Environment Variables (Production + Preview)

# Anthropic
ANTHROPIC_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Used by APIs to verify user JWTs (Auth /user). Falls back to service key if unset.
SUPABASE_ANON_KEY=
# Optional alias:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin dashboard
ADMIN_SECRET=

# Promo codes (comma-separated)
PROMO_CODES=

# YouTube Data API v3 (optional — enables ranked video shortlists with thumbnails/views)
# Without this key, research still returns AI precision search queries.
# YOUTUBE_API_KEY=

# Optional
# ALLOWED_ORIGINS=https://preshoot.app,https://www.preshoot.app,https://preshoot.vercel.app
# FREE_DAILY_SCANS=3
# DIR_DAILY_MSGS=50
