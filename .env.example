# Copy to Vercel Project → Environment Variables (Production + Preview)

# Anthropic
ANTHROPIC_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Used by APIs to verify user JWTs (Auth /user). Optional: if unset, server uses SUPABASE_SERVICE_KEY as the Auth apikey (server-side only).
SUPABASE_ANON_KEY=
# Optional alias:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin dashboard
ADMIN_SECRET=
# Optional session lifetime in hours (default 8, max 168)
# ADMIN_SESSION_HOURS=8

# Promo codes (comma-separated). Seeded into promo_codes with limits — not unlimited.
PROMO_CODES=
# Optional defaults when seeding from PROMO_CODES (DB rows remain source of truth)
# PROMO_DEFAULT_MAX_REDEMPTIONS=50
# PROMO_DEFAULT_EXPIRES_AT=2026-12-31T23:59:59.000Z

# YouTube Data API v3 (optional — enables ranked video shortlists with thumbnails/views)
# Without this key, research still returns AI precision search queries.
# YOUTUBE_API_KEY=

# Optional
# ALLOWED_ORIGINS=https://preshoot.app,https://www.preshoot.app,https://preshoot.vercel.app
# FREE_DAILY_SCANS=3
# DIR_DAILY_MSGS=50
# RESEARCH_DAILY_CALLS=30
