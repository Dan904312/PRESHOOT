# Copy to Vercel Project → Environment Variables (Production + Preview)

# Anthropic
ANTHROPIC_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Used by APIs to verify user JWTs (Auth /user). Optional: if unset, server uses SUPABASE_SERVICE_KEY as the Auth apikey (server-side only).
SUPABASE_ANON_KEY=
# Optional alias:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin dashboard
ADMIN_SECRET=
# Optional session lifetime in hours (default 8, max 168)
# ADMIN_SESSION_HOURS=8
# Optional API spend warning flags (USD). Displayed in admin; they do not auto-ban.
# ADMIN_DAILY_SPEND_WARN=10
# ADMIN_MONTHLY_SPEND_WARN=50
# ADMIN_USER_SPEND_WARN=5

# Optional transactional email (admin Messaging). Without these, send is logged as failed.
# RESEND_API_KEY=
# EMAIL_FROM=PreShoot <noreply@preshoot.app>

# Promo codes (comma-separated). Seeded into promo_codes with limits — not unlimited.
PROMO_CODES=
# Optional defaults when seeding from PROMO_CODES (DB rows remain source of truth)
# PROMO_DEFAULT_MAX_REDEMPTIONS=50
# PROMO_DEFAULT_EXPIRES_AT=2026-12-31T23:59:59.000Z

# YouTube Data API v3 (optional). Enables:
# - ranked YouTube reference shortlists with thumbnails and view counts
# - YouTube most-popular charts on Trending
# - topic search on Trending
# - public stats when a creator pastes a YouTube video URL
# Without this key, those features show an honest unavailable/empty state. Nothing is faked.
# YOUTUBE_API_KEY=

# CapCut has no public third-party template catalog or OAuth API.
# PreShoot opens CapCut template-center search URLs. Do not add a fake CapCut key.

# TikTok / Instagram official APIs are not wired. Required if those providers are enabled later:
# TIKTOK_CLIENT_KEY=
# INSTAGRAM_ACCESS_TOKEN=

# Optional
# ALLOWED_ORIGINS=https://preshoot.app,https://www.preshoot.app,https://preshoot.vercel.app
# FREE_DAILY_SCANS=3
# DIR_DAILY_MSGS=50
# RESEARCH_DAILY_CALLS=30
